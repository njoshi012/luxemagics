{% comment %}
  Calendar illustrations for the bulk order page. Colours follow the section's colour scheme.

  Accepts:
  - type: {String} 'desk' | 'wall' | 'fridge' | 'photo'
  - label: {String} accessible description
  - year: {String} year printed on desk and fridge calendars

  Usage:
  {% render 'lm-bulk-illustration', type: 'desk', label: 'Desk calendar' %}
{% endcomment %}

{%- case type -%}
  {%- when 'wall' -%}
    <svg viewBox="0 0 320 200" role="img" aria-label="{{ label | escape }}" preserveAspectRatio="xMidYMid meet">
      <rect x="60" y="22" width="200" height="168" rx="6" class="lmb-i-paper lmb-i-stroke" stroke-width="2.5"/>
      <rect x="74" y="42" width="172" height="68" class="lmb-i-pale lmb-i-stroke" stroke-width="2"/>
      <polygon points="74,110 120,72 150,94 186,60 246,110" class="lmb-i-accent lmb-i-stroke" stroke-width="2" stroke-linejoin="round"/>
      <g class="lmb-i-ink">
        <circle cx="110" cy="22" r="5"/><circle cx="160" cy="22" r="5"/><circle cx="210" cy="22" r="5"/>
        <rect x="74" y="122" width="60" height="7"/>
        <circle cx="86" cy="146" r="3"/><circle cx="116" cy="146" r="3"/><circle cx="146" cy="146" r="3"/><circle cx="176" cy="146" r="3"/><circle cx="206" cy="146" r="3"/><circle cx="236" cy="146" r="3"/>
        <circle cx="86" cy="166" r="3"/><circle cx="116" cy="166" r="3"/><circle cx="146" cy="166" r="3"/><circle cx="176" cy="166" r="3"/><circle cx="206" cy="166" r="3"/><circle cx="236" cy="166" r="3"/>
      </g>
    </svg>
  {%- when 'fridge' -%}
    <svg viewBox="0 0 320 200" role="img" aria-label="{{ label | escape }}" preserveAspectRatio="xMidYMid meet">
      <rect x="70" y="40" width="180" height="128" rx="10" class="lmb-i-paper"/>
      <rect x="70" y="40" width="180" height="30" rx="10" class="lmb-i-accent"/>
      <rect x="70" y="56" width="180" height="14" class="lmb-i-accent"/>
      <rect x="70" y="40" width="180" height="128" rx="10" fill="none" class="lmb-i-stroke" stroke-width="2.5"/>
      <line x1="70" y1="70" x2="250" y2="70" class="lmb-i-stroke" stroke-width="2.5"/>
      <text x="160" y="62" text-anchor="middle" font-size="18" font-weight="700" class="lmb-i-ink lmb-i-text">{{ year }}</text>
      <g class="lmb-i-pale lmb-i-stroke" stroke-width="1.5">
        <rect x="84" y="82" width="22" height="20" rx="4"/><rect x="116" y="82" width="22" height="20" rx="4"/><rect x="148" y="82" width="22" height="20" rx="4"/><rect x="180" y="82" width="22" height="20" rx="4"/><rect x="212" y="82" width="22" height="20" rx="4"/>
        <rect x="84" y="110" width="22" height="20" rx="4"/><rect x="116" y="110" width="22" height="20" rx="4"/><rect x="148" y="110" width="22" height="20" rx="4"/><rect x="180" y="110" width="22" height="20" rx="4"/><rect x="212" y="110" width="22" height="20" rx="4"/>
        <rect x="84" y="138" width="22" height="20" rx="4"/><rect x="116" y="138" width="22" height="20" rx="4"/><rect x="148" y="138" width="22" height="20" rx="4"/><rect x="180" y="138" width="22" height="20" rx="4"/>
      </g>
      <g class="lmb-i-ink"><circle cx="98" cy="40" r="10"/><circle cx="222" cy="40" r="10"/></g>
    </svg>
  {%- when 'photo' -%}
    <svg viewBox="0 0 320 200" role="img" aria-label="{{ label | escape }}" preserveAspectRatio="xMidYMid meet">
      <rect x="66" y="16" width="188" height="170" rx="6" class="lmb-i-paper lmb-i-stroke" stroke-width="2.5"/>
      <rect x="82" y="32" width="156" height="84" class="lmb-i-pale lmb-i-stroke" stroke-width="2"/>
      <circle cx="118" cy="58" r="10" class="lmb-i-accent lmb-i-stroke" stroke-width="2"/>
      <polygon points="82,116 130,82 160,102 196,70 238,116" class="lmb-i-accent lmb-i-stroke" stroke-width="2" stroke-linejoin="round"/>
      <g class="lmb-i-ink">
        <rect x="82" y="128" width="84" height="7"/>
        <rect x="82" y="142" width="124" height="5" opacity="0.3"/>
        <circle cx="96" cy="166" r="3"/><circle cx="128" cy="166" r="3"/><circle cx="160" cy="166" r="3"/><circle cx="192" cy="166" r="3"/><circle cx="224" cy="166" r="3"/>
      </g>
    </svg>
  {%- else -%}
    <svg viewBox="0 0 320 200" role="img" aria-label="{{ label | escape }}" preserveAspectRatio="xMidYMid meet">
      <ellipse cx="160" cy="176" rx="95" ry="8" class="lmb-i-ink" opacity="0.12"/>
      <polygon points="70,170 250,170 236,48 84,48" class="lmb-i-paper lmb-i-stroke" stroke-width="2.5" stroke-linejoin="round"/>
      <polygon points="84,48 236,48 239,84 81,84" class="lmb-i-accent lmb-i-stroke" stroke-width="2.5" stroke-linejoin="round"/>
      <text x="160" y="73" text-anchor="middle" font-size="22" font-weight="700" class="lmb-i-ink lmb-i-text">{{ year }}</text>
      <g class="lmb-i-ink">
        <circle cx="104" cy="106" r="3.5"/><circle cx="132" cy="106" r="3.5"/><circle cx="160" cy="106" r="3.5"/><circle cx="188" cy="106" r="3.5"/><circle cx="216" cy="106" r="3.5"/>
        <circle cx="104" cy="128" r="3.5"/><circle cx="132" cy="128" r="3.5"/><circle cx="160" cy="128" r="3.5"/><circle cx="188" cy="128" r="3.5"/><circle cx="216" cy="128" r="3.5"/>
        <circle cx="104" cy="150" r="3.5"/><circle cx="132" cy="150" r="3.5"/><circle cx="160" cy="150" r="3.5"/><circle cx="188" cy="150" r="3.5"/><circle cx="216" cy="150" r="3.5"/>
      </g>
    </svg>
{%- endcase -%}
