{%- comment -%}
  Luxe Magics — Bulk order enquiry form.
  Uses the Shopify contact form, so enquiries are emailed to the store's sender email
  and every field below arrives in that email.
{%- endcomment -%}

{{ 'section-lm-bulk-order.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign types = section.settings.calendar_types | newline_to_br | split: '<br />'
  assign personalisation = section.settings.personalisation_options | newline_to_br | split: '<br />'
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
  #bulk-enquiry {
    --lmb-section-bg: var(--color-background);
  }
  #bulk-enquiry .lmb-enquiry__aside .lmb__eyebrow {
    color: rgb(var(--lmb-section-bg));
  }
{%- endstyle -%}

<div
  id="bulk-enquiry"
  class="lmb color-{{ section.settings.color_scheme }} gradient{% if section.settings.show_borders %} lmb__border-y{% endif %}"
>
  <div class="page-width section-{{ section.id }}-padding">
    <div class="lmb-enquiry__grid">
      {%- assign form_class = 'lmb-enquiry__form color-' | append: section.settings.form_color_scheme -%}
      {%- form 'contact', id: 'BulkEnquiryForm', class: form_class -%}
        <div class="lmb-enquiry__intro">
          <h2>{{ section.settings.heading | escape }}</h2>
          {%- if section.settings.text != blank -%}
            <p>{{ section.settings.text | escape }}</p>
          {%- endif -%}
        </div>

        {%- if form.posted_successfully? -%}
          <div class="lmb-enquiry__status" role="status" tabindex="-1" autofocus>
            {{ section.settings.success_message | escape }}
          </div>
        {%- elsif form.errors -%}
          <div class="lmb-enquiry__status" role="alert" tabindex="-1" autofocus>
            {{ 'templates.contact.form.error_heading' | t }}
            <ul>
              {%- for field in form.errors -%}
                <li>{{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}</li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}

        <input type="hidden" name="contact[Enquiry type]" value="{{ section.settings.enquiry_tag | escape }}">
        <input type="hidden" name="contact[Page]" value="{{ page.title | default: request.path | escape }}">

        <div class="lmb-enquiry__row">
          <div class="lmb-field">
            <label for="Bulk-name">Full name</label>
            <input
              id="Bulk-name"
              class="lmb-field__input"
              type="text"
              name="contact[name]"
              autocomplete="name"
              required
              value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
            >
          </div>
          <div class="lmb-field">
            <label for="Bulk-company">Company or organisation</label>
            <input id="Bulk-company" class="lmb-field__input" type="text" name="contact[Company]" autocomplete="organization">
          </div>
        </div>

        <div class="lmb-enquiry__row">
          <div class="lmb-field">
            <label for="Bulk-email">Email</label>
            <input
              id="Bulk-email"
              class="lmb-field__input"
              type="email"
              name="contact[email]"
              autocomplete="email"
              spellcheck="false"
              autocapitalize="off"
              required
              value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
            >
          </div>
          <div class="lmb-field">
            <label for="Bulk-phone">Phone or WhatsApp</label>
            <input
              id="Bulk-phone"
              class="lmb-field__input"
              type="tel"
              name="contact[phone]"
              autocomplete="tel"
              pattern="[0-9\-\+\s]*"
              value="{{ form.phone }}"
            >
          </div>
        </div>

        <div class="lmb-enquiry__row">
          <div class="lmb-field">
            <label for="Bulk-type">Calendar type</label>
            <select id="Bulk-type" class="lmb-field__input" name="contact[Calendar type]" data-bulk-select>
              <option value="Not sure yet">Not sure yet</option>
              {%- for type in types -%}
                {%- assign type = type | strip -%}
                {%- if type != blank -%}
                  <option value="{{ type | escape }}">{{ type | escape }}</option>
                {%- endif -%}
              {%- endfor -%}
            </select>
          </div>
          <div class="lmb-field">
            <label for="Bulk-qty">Approximate quantity (minimum {{ section.settings.min_quantity }})</label>
            <input
              id="Bulk-qty"
              class="lmb-field__input"
              type="number"
              name="contact[Quantity]"
              min="{{ section.settings.min_quantity }}"
              inputmode="numeric"
              required
              placeholder="e.g. 50"
            >
          </div>
        </div>

        <div class="lmb-enquiry__row">
          <div class="lmb-field">
            <label for="Bulk-brand">Personalisation</label>
            <select id="Bulk-brand" class="lmb-field__input" name="contact[Personalisation]">
              {%- for option in personalisation -%}
                {%- assign option = option | strip -%}
                {%- if option != blank -%}
                  <option value="{{ option | escape }}">{{ option | escape }}</option>
                {%- endif -%}
              {%- endfor -%}
            </select>
          </div>
          <div class="lmb-field">
            <label for="Bulk-date">Needed by</label>
            <input id="Bulk-date" class="lmb-field__input" type="date" name="contact[Needed by]" data-bulk-date>
          </div>
        </div>

        <div class="lmb-field">
          <label for="Bulk-msg">Anything else we should know</label>
          <textarea id="Bulk-msg" class="lmb-field__input" rows="4" name="contact[body]">{{ form.body }}</textarea>
        </div>

        <div class="lmb-enquiry__submit">
          <button type="submit" class="lmb-btn">{{ section.settings.button_label | escape }}</button>
          {%- if section.settings.submit_note != blank -%}
            <span class="lmb-enquiry__note lmb__muted">{{ section.settings.submit_note | escape }}</span>
          {%- endif -%}
        </div>
      {%- endform -%}

      <div class="lmb-enquiry__aside color-{{ section.settings.aside_color_scheme }}">
        <div class="lmb__eyebrow">Your selection</div>
        <div class="lmb-enquiry__selection" data-bulk-selection data-empty="{{ section.settings.empty_selection | escape }}">
          {{- section.settings.empty_selection | escape -}}
        </div>
        <div class="lmb-enquiry__divider"></div>
        {%- if section.settings.tips != blank -%}
          <div class="lmb__eyebrow">{{ section.settings.tips_heading | escape }}</div>
          <div class="rte">{{ section.settings.tips }}</div>
          <div class="lmb-enquiry__divider"></div>
        {%- endif -%}
        {%- if section.settings.address != blank -%}
          <div class="rte">{{ section.settings.address }}</div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

<script>
  (function () {
    const root = document.getElementById('bulk-enquiry');
    if (!root) return;
    const select = root.querySelector('[data-bulk-select]');
    const selection = root.querySelector('[data-bulk-selection]');
    const date = root.querySelector('[data-bulk-date]');

    const sync = () => {
      const picked = select.value && select.value !== 'Not sure yet';
      selection.textContent = picked ? select.value : selection.dataset.empty;
      document.querySelectorAll('[data-bulk-pick]').forEach((btn) => {
        const on = btn.dataset.bulkPick === select.value;
        btn.setAttribute('aria-pressed', on);
        btn.textContent = on ? btn.dataset.selectedLabel : btn.dataset.label;
      });
    };
    select.addEventListener('change', sync);
    sync();

    // "Select for enquiry" buttons in the range section pick the calendar here and jump to the form.
    document.addEventListener('click', (event) => {
      const btn = event.target.closest('[data-bulk-pick]');
      if (!btn) return;
      const value = btn.dataset.bulkPick;
      if (![...select.options].some((o) => o.value === value)) select.add(new Option(value, value));
      select.value = value;
      sync();
      root.scrollIntoView({ behavior: 'smooth', block: 'start' });
      select.focus({ preventScroll: true });
    });

    const today = new Date();
    today.setMinutes(today.getMinutes() - today.getTimezoneOffset());
    date.min = today.toISOString().slice(0, 10);
  })();
</script>

{% schema %}
{
  "name": "Bulk order – Enquiry",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Bulk order enquiry" },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Tell us about your order and we will reply with a quote and design options."
    },
    {
      "type": "textarea",
      "id": "calendar_types",
      "label": "Calendar types",
      "info": "One per line.",
      "default": "Desk Calendar\nWall Calendar\nMagnetic Fridge Calendar\nPhoto Memory Calendar"
    },
    {
      "type": "textarea",
      "id": "personalisation_options",
      "label": "Personalisation options",
      "info": "One per line.",
      "default": "Our logo and brand colours\nCustom photos\nStandard design\nNot sure yet"
    },
    { "type": "number", "id": "min_quantity", "label": "Minimum order quantity", "default": 25 },
    { "type": "text", "id": "button_label", "label": "Submit button label", "default": "Send enquiry" },
    {
      "type": "text",
      "id": "submit_note",
      "label": "Note next to button",
      "default": "We usually reply within one working day."
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "Thank you! Your enquiry is in. We will reply with a quote and design options shortly."
    },
    {
      "type": "text",
      "id": "enquiry_tag",
      "label": "Enquiry label",
      "info": "Added to the enquiry email so you can filter bulk enquiries in your inbox.",
      "default": "Bulk order – 2027 calendars"
    },
    { "type": "header", "content": "Side panel" },
    { "type": "text", "id": "empty_selection", "label": "Text when nothing is selected", "default": "No calendar picked yet" },
    { "type": "text", "id": "tips_heading", "label": "Tips heading", "default": "Good to know" },
    {
      "type": "richtext",
      "id": "tips",
      "label": "Tips",
      "default": "<ul><li>Share your logo or photos when we reply and we will build your proof.</li><li>Tell us your gifting date so we can plan printing around it.</li><li>Mixed formats in one order are fine. Mention them in your message.</li></ul>"
    },
    {
      "type": "richtext",
      "id": "address",
      "label": "Contact details",
      "default": "<p>Luxe Magics<br/>Hyderabad, India<br/>luxemagics.com</p>"
    },
    { "type": "header", "content": "Colors and spacing" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Section background", "default": "scheme-23569c26-f5ed-40b4-9abf-cec33cbe9e35" },
    { "type": "color_scheme", "id": "form_color_scheme", "label": "Form card", "default": "scheme-1" },
    { "type": "color_scheme", "id": "aside_color_scheme", "label": "Side panel", "default": "scheme-4" },
    { "type": "checkbox", "id": "show_borders", "label": "Show top and bottom border", "default": true },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_top", "default": 72 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_bottom", "default": 80 }
  ],
  "presets": [{ "name": "Bulk order – Enquiry" }]
}
{% endschema %}
