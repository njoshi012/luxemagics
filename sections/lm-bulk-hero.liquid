{%- comment -%}
  Luxe Magics — Bulk order hero
{%- endcomment -%}

{{ 'section-lm-bulk-order.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="lmb color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="lmb-hero__grid">
      <div class="lmb-hero__copy">
        {%- if section.settings.eyebrow != blank -%}
          <div class="lmb__eyebrow">{{ section.settings.eyebrow | escape }}</div>
        {%- endif -%}
        <h1>{{ section.settings.heading | escape }}</h1>
        {%- if section.settings.text != blank -%}
          <div class="lmb-hero__text rte">{{ section.settings.text }}</div>
        {%- endif -%}

        {%- if section.settings.button_label != blank or section.settings.button_label_2 != blank -%}
          <div class="lmb__buttons">
            {%- if section.settings.button_label != blank -%}
              <a href="{{ section.settings.button_link | default: '#bulk-enquiry' }}" class="lmb-btn lmb-btn--accent">
                {{- section.settings.button_label | escape -}}
              </a>
            {%- endif -%}
            {%- if section.settings.button_label_2 != blank -%}
              <a
                href="{{ section.settings.button_link_2 | default: '#bulk-sample' }}"
                class="lmb-btn lmb-btn--outline"
                {% if section.settings.button_link_2 contains '.pdf' %}
                  target="_blank" rel="noopener"
                {% endif %}
              >
                {{- section.settings.button_label_2 | escape -}}
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if section.settings.quote != blank -%}
          <p class="lmb-hero__quote lmb__muted">{{ section.settings.quote | escape }}</p>
        {%- endif -%}
      </div>

      <div class="lmb-hero__visual">
        <div class="lmb-hero__card">
          {%- if section.settings.image != blank -%}
            {{
              section.settings.image
              | image_url: width: 1200
              | image_tag: loading: 'eager', sizes: '(min-width: 990px) 50vw, 100vw', widths: '400, 600, 800, 1200'
            }}
          {%- endif -%}
          {%- if section.settings.big_text != blank -%}
            <div class="lmb-hero__big">{{ section.settings.big_text | escape }}</div>
          {%- endif -%}
          {%- if section.blocks.size > 0 -%}
            <div class="lmb__pills">
              {%- for block in section.blocks -%}
                <span class="lmb__pill" {{ block.shopify_attributes }}>{{ block.settings.label | escape }}</span>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Bulk order – Hero",
  "tag": "section",
  "class": "section",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Bulk orders · 2027 calendars" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Give them a year they will want to keep." },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Custom 2027 calendars for corporate gifting, client thank-yous, events and festive hampers. Made in Hyderabad and personalised with your brand or their photos.</p>"
    },
    { "type": "text", "id": "button_label", "label": "Primary button label", "default": "Enquire for bulk" },
    { "type": "url", "id": "button_link", "label": "Primary button link", "info": "Leave empty to jump to the enquiry form." },
    { "type": "text", "id": "button_label_2", "label": "Secondary button label", "default": "Download catalogue" },
    { "type": "url", "id": "button_link_2", "label": "Secondary button link", "info": "Upload the PDF in Content > Files and paste its link here." },
    { "type": "text", "id": "quote", "label": "Quote line", "default": "We live in a world where we capture everything but remember nothing." },
    { "type": "header", "content": "Feature card" },
    { "type": "text", "id": "big_text", "label": "Big text", "default": "2027" },
    { "type": "image_picker", "id": "image", "label": "Image (optional)" },
    { "type": "header", "content": "Colors and spacing" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "info": "The card uses this scheme's button colour.", "default": "scheme-2" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_top", "default": 40 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_bottom", "default": 72 }
  ],
  "blocks": [
    {
      "type": "pill",
      "name": "Pill",
      "settings": [{ "type": "text", "id": "label", "label": "Label", "default": "Desk" }]
    }
  ],
  "presets": [
    {
      "name": "Bulk order – Hero",
      "blocks": [
        { "type": "pill", "settings": { "label": "Desk" } },
        { "type": "pill", "settings": { "label": "Wall" } },
        { "type": "pill", "settings": { "label": "Fridge" } },
        { "type": "pill", "settings": { "label": "Photo" } }
      ]
    }
  ]
}
{% endschema %}
